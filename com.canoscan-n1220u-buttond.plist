<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.canoscan-n1220u-buttond</string>

	<!-- Update these two paths to match where you installed the wrapper
	     script and action script (see README.md). The wrapper primes the
	     scanner via SANE before starting the poll loop. -->
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/canoscan-n1220u-buttond.sh</string>
		<string>/usr/local/etc/canoscan-n1220u-buttond/scan.script</string>
	</array>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/usr/local/var/log/canoscan-n1220u-buttond.log</string>
	<key>StandardErrorPath</key>
	<string>/usr/local/var/log/canoscan-n1220u-buttond.log</string>
</dict>
</plist>
